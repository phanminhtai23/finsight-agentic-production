# ---- App ----
ENVIRONMENT=dev
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# ---- Datastores ----
# Default Postgres account, created when the postgres container first starts.
# If you change these, also update the two DSNs below to match.
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight
# Async DSN for application tables (asyncpg)
DATABASE_URL=postgresql+asyncpg://finsight:finsight@postgres:5432/finsight
# Sync DSN for LangGraph PostgresSaver/PostgresStore (psycopg)
CHECKPOINT_DATABASE_URL=postgresql://finsight:finsight@postgres:5432/finsight
REDIS_URL=redis://redis:6379/0

# ---- LLM / embeddings ----
LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite-preview
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIM=3072


# ---- Observability (LangSmith) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight
LANGSMITH_TRACING=false

# ---- File storage (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Qdrant API (for agentic decision making) ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=finsight_chunks
# ---- MCP tool server ----
MCP_SERVER_URL=http://mcp:8001/mcp

# ---- Auth / security ----
# In prod the app refuses to start unless this is a strong secret (>=32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod-please
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
FRONTEND_URL=http://localhost:5173

# ---- Reliability (retry/backoff/timeout around LLM & embedding calls) ----
LLM_MAX_ATTEMPTS=4
LLM_RETRY_INITIAL_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=20.0
LLM_TIMEOUT_SECONDS=60.0

# ---- Guardrails / safety ----
GUARDRAILS_ENABLED=true
MAX_INPUT_CHARS=8000
REDACT_PII_IN_LOGS=true

# ---- Rate limiting (Redis fixed-window, per authenticated user) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ---- Storage quota (per user, in MB) ----
STORAGE_QUOTA_MB=100

# ---- Google OAuth (optional — login with Google) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Email / SMTP (optional — verification emails; dev returns the token if unset) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=phanminhtai23@gmail.com

# ---- Email via Resend (preferred on hosts that block SMTP ports, e.g. DigitalOcean) ----
# Get a key at https://resend.com (free). When set, Resend is used instead of SMTP.
RESEND_API_KEY=
# Verify your domain in Resend, then use e.g. no-reply@finsightagent.tech.
# "onboarding@resend.dev" works without verification but only delivers to the account owner's email.
RESEND_FROM=onboarding@resend.dev
